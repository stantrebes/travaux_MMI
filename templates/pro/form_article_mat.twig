{% extends 'base.twig' %}

{% block content %}
    <h1>Ajouter un article de matériel</h1>
    {% if error %}
        <div class="error-message">{{ error }}</div>
    {% endif %}
    <form action="admin_article.php?page=article_mat&action=create" method="post" class="form-util">
        <div class="form-group">
            <input type="text" name="titre" placeholder="Saisir un titre" required>
        </div>
        <div class="form-group">
            <input type="text" name="img" placeholder="Saisir le lien d'une image" required>
        </div>
        <div class="form-group">
            <textarea name="detail" placeholder="Saisir le detail" required></textarea>
        </div>
        <div class="form-group">
            <input type="text" name="prix" placeholder="Saisir le prix" required>
        </div>
        <div class="form-group">
            <input type="text" name="vendeur" placeholder="Saisir le nom du vendeur" required>
        </div>
        <div class="form-group">
            <input type="text" name="filtre" placeholder="Saisir le filtre" required>
        </div>
        <button type="submit" class="btn">Créer l'article</button>
    </form>
    <a href="admin_article.php?page=article_mat" class="btn-back">Retour à la liste</a>
{% endblock %}