{% extends "base.twig" %}

{% block content %}
<div class="detail-cours-container">
    <div class="image-section">
        <img src="{{ articles.img }}" alt="{{ articles.titre }}">
    </div>

    <div class="info-section">
        <h2>{{ articles.titre }}</h2>
        <p>{{ articles.detail }}</p>
        
        <div class="filter-section">
            <p>{{ articles.filtre }}</p>
        </div>

        <p>{{ articles.texte }}</p>
        <p>Auteur : {{ articles.vendeur }}</p>

        <div class="button-section">
            <a href="#" class="btn">Réserver</a>
            <a href="client_article.php?page={{ page }}" class="btn-back">Retour aux catégories</a>
        </div>
    </div>
</div>
{% endblock %}