{% extends 'base.twig' %}

{% block content %}
    <h1>Modifier un article</h1>
    {% if error %}
        <div class="error-message">{{ error }}</div>
    {% endif %}
    <form action="admin_article.php?page=article_mat&action=update" method="post" class="form-util">
        <input type="hidden" name="id_bloc" value="{{ article.id_bloc }}">
        <div class="form-group">
            <input type="text" name="titre" placeholder="Saisir un titre" value="{{ article.titre }}" required>
        </div>
        <div class="form-group">
            <input type="text" name="img" placeholder="Saisir le lien d'une image" value="{{ article.img }}" required>
        </div>
        <div class="form-group">
            <textarea name="detail" placeholder="Saisir le detail" required>{{ article.detail }}</textarea>
        </div>
        <div class="form-group">
            <input type="text" name="prix" placeholder="Saisir le prix" value="{{ article.prix }}" required>
        </div>
        <div class="form-group">
            <input type="text" name="vendeur" placeholder="Saisir le nom du vendeur" value="{{ article.vendeur }}" required>
        </div>
        <div class="form-group">
            <input type="text" name="filtre" placeholder="Saisir le filtre" value="{{ article.filtre }}" required>
        </div>
        <button type="submit" class="btn">Enregistrer les modifications</button>
    </form>
    <a href="admin_article.php?page=article_mat" class="btn-back">Retour à la liste</a>
{% endblock %}