{% extends 'base.twig' %}

{% block content %}
    <h1>Modifier un tutoriel</h1>
    {% if error %}
        <div class="error-message">{{ error }}</div>
    {% endif %}
    <form action="admin_article.php?page=article_tuto&action=update&id={{ article.id_bloc }}" method="post" class="form-util">
        <input type="hidden" name="id_bloc" value="{{ article.id_bloc }}">
        <div class="form-group">
            <input type="text" name="titre" placeholder="Saisir un titre" value="{{ article.titre }}" required>
        </div>
        <div class="form-group">
            <input type="text" name="img" placeholder="Saisir le lien d'une image" value="{{ article.img }}" required>
        </div>
        <div class="form-group">
            <textarea name="detail" placeholder="Saisir le résumé" required>{{ article.detail }}</textarea>
        </div>
        <div class="form-group">
            <textarea name="texte" placeholder="Saisir le contenu du tutoriel" required>{{ article.texte }}</textarea>
        </div>
        <div class="form-group">
            <input type="text" name="vendeur" placeholder="Saisir le nom de l'auteur" value="{{ article.vendeur }}" required>
        </div>
        <div class="form-group">
            <input type="text" name="filtre" placeholder="Saisir la catégorie" value="{{ article.filtre }}" required>
        </div>
        <button type="submit" class="btn">Enregistrer les modifications</button>
    </form>
    <a href="admin_article.php?page=article_tuto" class="btn-back">Retour à la liste</a>
{% endblock %}